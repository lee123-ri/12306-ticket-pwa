# ===== 服务基础配置 =====
# 监听端口
PORT=8080
# 站点基础地址（本地调试填 http://localhost:8080，部署后填你的域名或公网 IP，Web Push 必须 https）
BASE_URL=http://localhost:8080

# ===== DeepSeek 自然语言理解（可选）=====
# 不填则走关键词规则兜底，也能查票，但体验不如大模型
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ===== Web Push（VAPID）=====
# 首次运行会自动生成并写入 data/vapid.json，也可以手动填
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== 监控轮询 =====
# 默认轮询间隔（秒），抢票场景建议 5-10，普通监控 30-60
POLL_INTERVAL_SEC=10
